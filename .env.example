# 只放占位值，真实值写进本地 .env，不提交。
# 登录凭证有效期（分钟）
SESSION_TTL_MINUTES=120

# 允许访问的前端来源，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite 文件路径，容器内默认 /app/data/app.db
APP_DB_PATH=./data/app.db

# 初始化练习账号用（python -m app.seed）
SEED_USERNAME=demo
SEED_PASSWORD=<在这里填练习密码>
SEED_DISPLAY_NAME=练习同学
